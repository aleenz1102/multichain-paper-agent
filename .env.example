# Copy this file to .env in the repository root and add your own key.
# Keep .env private; it is ignored by Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Default OpenAI API base URL. Leave unset to use the default.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional TypeSafe AI candidate ranking (advisory only; no key is required).
# Set the key in your private .env or deployment environment, never in source control.
# TYPESAFE_API_KEY=
# TYPESAFE_RANKING_ENABLED=1
